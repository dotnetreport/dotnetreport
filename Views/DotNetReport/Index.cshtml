@using System.Configuration

@{
    ViewBag.Title = "Report Builder";
    Layout = "../shared/_Layout.Report.cshtml";
}
<!--
The html and JavaScript code below is related to presentation for the Report Builder. You don't have to change it, unless you intentionally want to
change something in the Report Builder's behavior in your Application.

Its Recommended you use it as is, and only change styling as needed to match your application. You will be responsible for managing and maintaining any changes.
-->
@section scripts{

<script type="text/javascript">

    var toastr = toastr || { error: function(msg) { window.alert(msg); }, success: function(msg) { window.alert(msg); } };

    var queryParams = Object.fromEntries((new URLSearchParams(window.location.search)).entries());

    $(document).ready(function() {
        ajaxcall({ url: '@Url.Action("GetUsersAndRoles", "DotNetReportApi")' }).done(function(data) {
            var vm = new reportViewModel({
                runReportUrl: '@Url.Action("Index")',
                reportWizard: $("#modal-reportbuilder"),
                execReportUrl: "@Url.Action("RunReport", "DotNetReportApi")",
                runLinkReportUrl: "@Url.Action("RunReportLink", "DotNetReportApi")",
                getSchemaFromSql: '@Url.Action("GetSchemaFromSql", "DotNetReportApi")',
                linkModal: $("#linkModal"),
                reportHeader: "report-header",
                fieldOptionsModal: $("#fieldOptionsModal"),
                lookupListUrl: '@Url.Action("GetLookupList", "DotNetReportApi")',
                apiUrl: '@Url.Action("CallReportApi", "DotNetReportApi")',
                runReportApiUrl: '@Url.Action("RunReportApi", "DotNetReportApi")',
                getUsersAndRolesUrl: '@Url.Action("GetUsersAndRoles", "DotNetReportApi")',
                reportId: queryParams.reportId || 0,
                userSettings: data,
                dataFilters: data.dataFilters,
                runExportUrl: "/api/DotnetReportApi/",
                getTimeZonesUrl: '@Url.Action("GetAllTimezones", "DotNetReportApi")',
                printReportUrl: "@Url.Action("ReportPrint", "DotNetReport", null, Context.Request.Scheme)",
                samePageOnRun: true
            });

            vm.init(queryParams.folderid || 0, data.noAccount, queryParams.reportId || 0);
            ko.applyBindings(vm);
            vm.textQuery.setupSearch();

            $(window).resize(function() {
                vm.DrawChart();
            });            
        });
    });
</script>
}

<div class="container-fluid">
    <div data-bind="template: {name: 'admin-mode-template'}, visible: allowAdmin" style="display: none;"></div>

    <!--
        The markup code below is related to presentation. You don't have to change it, unless you
        intentionally want to change something in the Report Builder's behavior in your Application.
        It's Recommended you use it as is. You will be responsible for managing and maintaining any changes.
    -->
    <!-- Folders/Report List -->
    <div id="report-start" data-bind="if: ReportMode() == 'start' || ReportMode() == 'generate'">
        <div class="card folder-panel" data-bind="visible: true" style="display: none;">
            <div class="card-header">
                <nav class="navbar navbar-expand-lg navbar-light bg-light">
                    <a class="navbar-brand" href="#" data-bind="click: function() {SelectedFolder(null); designingHeader(false); designingFooter(false); searchReports(''); $('#search-report').val([]).trigger('change'); }">Manage Reports</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav mr-auto">
                            <li class="nav-item" data-bind="visible: (CanSaveReports() || adminMode()) && (!SelectedFolder() || SelectedFolder().canEdit || adminMode())">
                                <a href="#" class="nav-link" data-bind="click: createNewReport" data-bs-toggle="modal" data-bs-target="#modal-reportbuilder">
                                    <span class="fa fa-plus"></span> New Report
                                </a>
                            </li>
                            <li class="nav-item" data-bind="visible: CanManageFolders() || adminMode()">
                                <a href="#" class="nav-link" data-bind="click: ManageFolder.newFolder">
                                    <span class="fa fa-folder-o"></span> Add Folder
                                </a>
                            </li>
                            <li class="nav-item dropdown" data-bind="visible: (CanManageFolders() || adminMode()) && SelectedFolder()!=null && (SelectedFolder().canEdit || SelectedFolder().canDelete || adminMode())">
                                <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="fa fa-folder"></span> Folder Options
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="#" data-bind="click: ManageFolder.editFolder, visible: SelectedFolder() && (SelectedFolder().canEdit || adminMode())">Edit Selected Folder</a>
                                    <a class="dropdown-item" href="#" data-bind="click: ManageFolder.deleteFolder, visible: SelectedFolder() && (SelectedFolder().canDelete || adminMode())">Delete Selected Folder</a>
                                    <a class="dropdown-item" href="#"
                                       data-bind="click: ManageFolder.addSubFolder, visible: SelectedFolder() && (SelectedFolder().canEdit || adminMode())">
                                        <span class="fa fa-folder"></span> Add Sub Folder
                                    </a>
                                </div>
                            </li>
                            <li class="nav-item dropdown" data-bind="visible: adminMode() && SelectedFolder() ==null">
                                <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="fa fa-window-maximize"></span> Header / Footer
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="#" data-bind="click: function(){ initHeaderDesigner(false); }">
                                        <span class="fa fa-arrow-up"></span> Report Header
                                    </a>
                                    <a class="dropdown-item" href="#" data-bind="click: function(){ initFooterDesigner(false); }">
                                        <span class="fa fa-arrow-down"></span> Report Footer
                                    </a>
                                </div>
                            </li>
                            <li class="nav-item dropdown" data-bind="visible: appSettings.showImportExport() || adminMode()">
                                <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="fa fa-exchange"></span> Import / Export
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="#" data-bind="click: function(){ selectMode(!selectMode()); }">
                                        <span data-bind="css: selectMode() ? 'fa fa-check-square text-primary' : 'fa fa-square-o'"></span>
                                        <span data-bind="text: selectMode() ? 'Cancel Select Mode' : 'Select Mode'"></span>
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#uploadFileModal" data-bind="visible: !selectMode()" title="Import Report from JSON file">
                                        <span class="fa fa-upload"></span> Import Reports
                                    </a>
                                    <a class="dropdown-item" href="#" data-bind="visible: selectMode, click: exportSelectedReportJson">
                                        <span class="fa fa-download"></span> Export Selected Reports
                                    </a>
                                </div>
                            </li>
                        </ul>
                        <div class="form-inline my-2 my-lg-0 ms-auto w-50">
                            <div class="input-group w-100">
                                <p id="search-input" class="form-control search-input" data-placeholder="Search Report by Name, Description or Data Field..."></p>
                                <span data-bind="click: searchForReports" class="input-group-text" style="height: 38px; cursor: pointer;" title="Search"><i class="fa fa-search"></i></span>
                                <span data-bind="click: function() {resetQuery(true, true);}" class="input-group-text" style="height: 38px; cursor: pointer;" title="Clear Search"><i class="fa fa-close"></i></span>
                                <span data-bind="visible: !selectMode(), click: function(){ onlyFavorites(!onlyFavorites()); }, css: { 'bg-warning-subtle': onlyFavorites() }, attr: { title: onlyFavorites() ? 'Showing only Favorites - click to show all' : 'Show only Favorites' }"
                                      class="input-group-text" style="height: 38px; cursor: pointer;">
                                    <i data-bind="css: onlyFavorites() ? 'fa fa-star text-warning' : 'fa fa-star-o'"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
            <div class="card-body">
                <div data-bind="visible: designingHeader, with: headerDesigner" style="display: none;" class="overflow-auto">
                    <div class="report-header-designer">
                        <div class="d-flex align-items-center flex-wrap mb-3">
                            <h6 class="mb-0 me-2"><i class="fa fa-window-maximize text-primary"></i> Report Headers</h6>
                            <span class="text-muted small">A client (or Global) can have several named headers. The one marked <b>Default</b> is used when a report doesn't pick one.</span>
                        </div>

                        <!-- Overall on/off for report headers -->
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="rptHeaderUse" data-bind="checked: UseReportHeader">
                            <label class="form-check-label" for="rptHeaderUse">Use report headers <span class="text-muted small">(uncheck to stop applying headers in reports)</span></label>
                        </div>

                        <!-- Off state (use `if` so .d-flex !important can't override a hidden state) -->
                        <div data-bind="if: !UseReportHeader()">
                            <div class="alert alert-secondary d-flex align-items-center justify-content-between py-2">
                                <span><i class="fa fa-eye-slash"></i> Report headers are turned off and won't be applied in reports.</span>
                                <button class="btn btn-primary btn-sm" data-bind="click: saveHtmlHeader"><i class="fa fa-save"></i> Save</button>
                            </div>
                        </div>

                        <!-- Designer (hidden when report headers are turned off) -->
                        <div data-bind="visible: UseReportHeader">
                        <!-- Selection toolbar -->
                        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                            <div data-bind="visible: clientListIds().length > 0">
                                <label class="form-label small text-muted mb-1">Client scope</label>
                                <select class="form-select form-select-sm" style="min-width: 200px;"
                                        data-bind="options: clientListIds,
                                            value: selectedHeaderClientId,
                                            optionsCaption: 'Global (all clients)',
                                            event: { change: function () { loadHeadersList(); } }">
                                </select>
                            </div>
                            <div>
                                <label class="form-label small text-muted mb-1">Header</label>
                                <select class="form-select form-select-sm" style="min-width: 240px;"
                                        data-bind="options: headersList,
                                            optionsText: 'label',
                                            optionsValue: 'id',
                                            value: selectedHeaderId,
                                            event: { change: function () { loadHeaderById(); } }">
                                </select>
                            </div>
                            <div class="ms-auto d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: newHeader"><i class="fa fa-plus"></i> New</button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: deleteHeader, visible: selectedHeaderId() > 0"><i class="fa fa-trash"></i> Delete</button>
                            </div>
                        </div>

                        <!-- Editor card -->
                        <div class="card shadow-sm">
                            <div class="card-header bg-light py-2 d-flex align-items-center flex-wrap gap-2">
                                <div class="flex-grow-1" style="min-width: 220px;">
                                    <input class="form-control form-control-sm fw-semibold" type="text" placeholder="Header name (e.g. Invoice header)" data-bind="value: headerName">
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="rptHeaderDefault" data-bind="checked: isDefault">
                                    <label class="form-check-label small" for="rptHeaderDefault">Default for this scope</label>
                                </div>
                            </div>
                            <div class="card-body p-2">
                                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-code"></i> Insert Variable
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{page.number}'); }">Page Number</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{page.total}'); }">Total Pages</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.user}'); }">Current User</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.user.roles}'); }">Current User Roles</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.datetime}'); }">Current Date/Time</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{report.name}'); }">Report Name</a></li>
                                        </ul>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="rptHeaderEveryPage" data-bind="checked: IncludeOnEveryPage">
                                        <label class="form-check-label small" for="rptHeaderEveryPage">Repeat on every page (PDF/Word)</label>
                                    </div>
                                </div>
                                <textarea id="report-header-editor"></textarea>
                            </div>
                            <div class="card-footer bg-white d-flex align-items-center flex-wrap gap-2 py-2">
                                <button type="button" class="btn btn-sm btn-link text-decoration-none px-0" data-bind="visible: !showClientScope(), click: function() { showClientScope(true); }">
                                    <i class="fa fa-user"></i> <span data-bind="text: headerClientId() ? 'Change client (' + headerClientId() + ')' : 'Restrict to a Client Id'"></span>
                                </button>
                                <div class="input-group input-group-sm" style="max-width: 400px;" data-bind="visible: showClientScope">
                                    <span class="input-group-text">Client Id</span>
                                    <input class="form-control" type="text" placeholder="Blank = Global" data-bind="value: headerClientId, event: { change: function () { applyHeaderScope(); } }">
                                    <button class="btn btn-outline-secondary" type="button" data-bind="click: cancelHeaderScope" title="Cancel"><i class="fa fa-times"></i></button>
                                    <span class="input-group-text bg-white" data-bs-toggle="tooltip" data-placement="top" title="Leave blank for a Global header. Changing this switches to that client's headers."><i class="fa fa-question-circle helptip"></i></span>
                                </div>
                                <button class="btn btn-primary btn-sm ms-auto" data-bind="click: saveHtmlHeader">
                                    <i class="fa fa-save"></i> Save Header
                                </button>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
                <div data-bind="visible: designingFooter, with: footerDesigner" style="display: none;" class="overflow-auto">
                    <div class="report-header-designer">
                        <div class="d-flex align-items-center flex-wrap mb-3">
                            <h6 class="mb-0 me-2"><i class="fa fa-window-minimize text-primary"></i> Report Footer</h6>
                            <span class="text-muted small">One footer per client (or Global), applied to reports where footers are turned on.</span>
                        </div>

                        <!-- Overall on/off for report footers -->
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="rptFooterUse" data-bind="checked: UseReportFooter">
                            <label class="form-check-label" for="rptFooterUse">Use report footers <span class="text-muted small">(uncheck to stop applying footers in reports)</span></label>
                        </div>

                        <!-- Off state (use `if` so .d-flex !important can't override a hidden state) -->
                        <div data-bind="if: !UseReportFooter()">
                            <div class="alert alert-secondary d-flex align-items-center justify-content-between py-2">
                                <span><i class="fa fa-eye-slash"></i> Report footers are turned off and won't be applied in reports.</span>
                                <button class="btn btn-primary btn-sm" data-bind="click: saveHtmlFooter"><i class="fa fa-save"></i> Save</button>
                            </div>
                        </div>

                        <!-- Designer (hidden when report footers are turned off) -->
                        <div data-bind="visible: UseReportFooter">
                        <!-- Selection toolbar (footer has one per scope, so just the client scope) -->
                        <div class="d-flex flex-wrap align-items-end gap-2 mb-3" data-bind="visible: clientListIds().length > 0">
                            <div>
                                <label class="form-label small text-muted mb-1">Client scope</label>
                                <select class="form-select form-select-sm" style="min-width: 200px;"
                                        data-bind="options: clientListIds,
                                            value: selectedFooterClientId,
                                            optionsCaption: 'Global (all clients)',
                                            event: { change: function () { loadHtmlFooter(false); } }">
                                </select>
                            </div>
                        </div>

                        <!-- Editor card -->
                        <div class="card shadow-sm">
                            <div class="card-body p-2">
                                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-code"></i> Insert Variable
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{page.number}'); }">Page Number</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{page.total}'); }">Total Pages</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.user}'); }">Current User</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.user.roles}'); }">Current User Roles</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{current.datetime}'); }">Current Date/Time</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: function() { insertPlaceholder('{report.name}'); }">Report Name</a></li>
                                        </ul>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="rptFooterEveryPage" data-bind="checked: IncludeOnEveryPage">
                                        <label class="form-check-label small" for="rptFooterEveryPage">Repeat on every page (PDF/Word)</label>
                                    </div>
                                </div>
                                <textarea id="report-footer-editor"></textarea>
                            </div>
                            <div class="card-footer bg-white d-flex align-items-center flex-wrap gap-2 py-2">
                                <button type="button" class="btn btn-sm btn-link text-decoration-none px-0" data-bind="visible: !showClientScope(), click: function() { showClientScope(true); }">
                                    <i class="fa fa-user"></i> <span data-bind="text: footerClientId() ? 'Change client (' + footerClientId() + ')' : 'Restrict to a Client Id'"></span>
                                </button>
                                <div class="input-group input-group-sm" style="max-width: 400px;" data-bind="visible: showClientScope">
                                    <span class="input-group-text">Client Id</span>
                                    <input class="form-control" type="text" placeholder="Blank = Global" data-bind="value: footerClientId, event: { change: function () { applyFooterScope(); } }">
                                    <button class="btn btn-outline-secondary" type="button" data-bind="click: cancelFooterScope" title="Cancel"><i class="fa fa-times"></i></button>
                                    <span class="input-group-text bg-white" data-bs-toggle="tooltip" data-placement="top" title="Leave blank for a Global footer. Changing this switches to that client's footer."><i class="fa fa-question-circle helptip"></i></span>
                                </div>
                                <button class="btn btn-primary btn-sm ms-auto" data-bind="click: saveHtmlFooter">
                                    <i class="fa fa-save"></i> Save Footer
                                </button>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
                <div data-bind="visible: !designingHeader() && !designingFooter()">
                    <div class="btn-group" style="float: right" role="group">
                        <button type="button" class="btn btn-light" data-bs-toggle="tooltip" title="List View"
                                data-bind="css: { 'active': layout() === 'list' }, click: toggleLayout">
                            <span class="fa fa-list"></span>
                        </button>
                        <button type="button" class="btn btn-light" data-bs-toggle="tooltip" title="Icon View"
                                data-bind="css: { 'active': layout() === 'icons' }, click: toggleLayout">
                            <span class="fa fa-th-large"></span>
                        </button>
                    </div>
                    <div data-bind="if: layout()=='icons'">
                        <div data-bind="visible: !SelectedFolder() && !searchReports()">
                            <p>Please choose Folders below to view Reports</p>
                            <ul class="folder-list" data-bind="foreach: rootFolders">
                                <li data-bind="click: function(){ $parent.SelectedFolder($data); }">
                                    <span data-bind="visible: $root.selectMode, click: function(d,e){ isSelected(!isSelected()); e.stopPropagation(); },
                                        css: isSelected() ? 'fa fa-check-square text-primary me-2' : 'fa fa-square-o me-2'"></span>
                                    <span class="fa fa-3x fa-folder text-secondary"></span>
                                    <span class="desc" data-bind="text: FolderName"></span>
                                    <div data-bind="visible: $root.adminMode" style="font-size: 0.75em; margin-top: 4px;" onclick="event.stopPropagation()">
                                        <span class="badge text-bg-info text-white" data-bind="text: UserId ? UserId : 'Any User'"></span>
                                        <span class="badge text-bg-info text-white" data-bind="text: UserRoles ? UserRoles : 'Any Role'"></span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div data-bind="visible: SelectedFolder() || searchReports()">
                            <div class="clearfix">
                                <p class="pull-left">Please choose a Report from this Folder</p>
                                <div class="pull-right">
                                    <a href="#" class="btn btn-light" data-bind="click: goBackFolder">
                                        <span data-bind="text: SelectedFolder() && SelectedFolder().ParentFolderId ? '..back to ' + (folderBreadcrumb().length > 1 ? folderBreadcrumb()[folderBreadcrumb().length - 2].FolderName : 'Folders') : '..back to Folders'"></span>
                                    </a>
                                </div>
                            </div>
                            <div class="list-group list-overflow">

                                <!-- Empty states -->
                                <div data-bind="if: SelectedFolder() != null
                                    && reportsInFolder().length == 0
                                    && subFoldersInFolder().length == 0
                                    && !searchReports()">
                                    <p class="text-muted">This folder is empty.</p>
                                </div>
                                <div data-bind="if: searchReports() && reportsInSearch().length==0 && foldersInSearch().length==0">
                                    No results found matching your search.
                                </div>

                                <!-- Search: matching folders -->
                                <div data-bind="if: searchReports() && foldersInSearch().length > 0">
                                    <div class="mt-1 mb-1"><strong><span class="fa fa-folder"></span> Matching Folders</strong></div>
                                    <ul class="folder-list" data-bind="foreach: foldersInSearch">
                                        <li data-bind="click: function(){ $parent.SelectedFolder($data); $parent.searchReports(''); }">
                                            <span class="fa fa-3x fa-folder text-secondary"></span>
                                            <span class="desc" data-bind="highlightedText: { text: FolderName, highlight: $parent.searchReports, css: 'highlight' }"></span>
                                            <div data-bind="visible: $root.adminMode" style="font-size: 0.75em; margin-top: 4px;" onclick="event.stopPropagation()">
                                                <div class="d-flex flex-wrap gap-1">
                                                    <span class="badge bg-info text-white" title="Manage Users" data-bind="text: UserId ? '👤 ' + UserId : '👤 Any User'"> </span>
                                                    <span class="badge bg-info text-white border" title="View only Users" data-bind="visible: ViewOnlyUserId"> 👁 <span data-bind="text: ViewOnlyUserId"></span> </span>
                                                    <span class="badge bg-info text-white border" title="Delete only Users" data-bind="visible: DeleteOnlyUserId"> 🗑 <span data-bind="text: DeleteOnlyUserId"></span> </span>
                                                    <span class="badge bg-info text-white" title="Manage Roles" data-bind="text: '🔑 ' + (UserRoles ? UserRoles : 'Any Role')"> </span>
                                                    <span class="badge bg-info text-white border" title="View only Roles" data-bind="visible: ViewOnlyUserRoles"> 👁 <span data-bind="text: ViewOnlyUserRoles"></span> </span>
                                                    <span class="badge bg-info text-white border" title="Delete only Roles" data-bind="visible: DeleteOnlyUserRoles"> 🗑 <span data-bind="text: DeleteOnlyUserRoles"></span> </span>
                                                    <span class="badge bg-info text-white" title="Client" data-bind="visible: ClientId"> 🏢 <span data-bind="text: ClientId"></span> </span>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                    <hr />
                                </div>

                                <!-- SUB-FOLDERS inside selected folder -->
                                <div data-bind="if: !searchReports() && subFoldersInFolder().length > 0">
                                    <ul class="folder-list" data-bind="foreach: subFoldersInFolder">
                                        <li data-bind="click: function(){ $parent.SelectedFolder($data); }">
                                            <span class="fa fa-3x fa-folder text-secondary"></span>
